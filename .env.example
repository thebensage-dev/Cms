# Copy to .env.local (gitignored) for `npm run dev`. In production the deploy job in
# .github/workflows/ci.yml writes these into the Coolify app; nothing is typed in.
# The GitHub Packages token for @thebensage-dev/ui goes in .npmrc instead (see .npmrc.example).

# PostgreSQL. Locally, any PostgreSQL 18 works, e.g.:
#   docker run -d --name cms-dev-db -e POSTGRES_DB=cms -e POSTGRES_USER=cms \
#     -e POSTGRES_PASSWORD=local-only -p 15432:5432 postgres:18.7-alpine
# In Coolify it's the cms-db service, with the generated SERVICE_PASSWORD_64_CMSDB.
DATABASE_URL=postgres://cms:local-only@localhost:15432/cms

# Signs Payload's own tokens: any long random string (production: derive:cms-payload).
PAYLOAD_SECRET=

# This CMS's public address (no trailing slash). The sign-in callback is APP_URL/auth/callback.
APP_URL=http://localhost:3003

# "true" adds the sites' current content when the database has no pages yet.
SEED_CONTENT=true

# Sign-in through authentik (client "cms", created by Infrastructure's blueprint). Only
# cms-editors and authentik Admins get in. Without these, nobody can sign in: Payload's own
# password login is switched off.
# OIDC_ISSUER_URL=https://id.example.com/application/o/cms/
# OIDC_CLIENT_ID=cms
# OIDC_CLIENT_SECRET=
# Encrypts the session cookie: any long random string (production: derive:cms-session).
# AUTH_SECRET=
# Only when the server can't reach OIDC_ISSUER_URL itself: the origin to call instead (the local
# Docker stack sets http://authentik-server:9000).
# OIDC_INTERNAL_URL=

# Optional: draft preview. The same value as PREVIEW_SECRET on the sites (any long random string;
# production: derive:cms-preview). It signs the Preview links and lets the sites read drafts.
# PREVIEW_SECRET=
# Optional: the sites, for the admin's Preview button on each page.
# PORTFOLIO_URL=http://localhost:3001
# USER_DIRECTORY_URL=http://localhost:3000
