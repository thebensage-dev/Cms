{
  "name": "@thebensage-dev/cms-client",
  "version": "0.1.0",
  "description": "Typed, cached reader for TheBensage CMS (Payload): a site's pages, projects and settings, with a snapshot fallback so the site renders while the CMS is down.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebensage-dev/Cms.git",
    "directory": "clients/typescript"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cms-snapshot": "./bin/cms-snapshot.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "npm run generate:check && npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
