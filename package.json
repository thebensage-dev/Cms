{
  "name": "cms",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docker:build": "node scripts/docker-build.mjs",
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "payload": "payload",
    "generate": "payload generate:types && payload generate:importmap && prettier --write src/payload-types.ts \"src/app/(payload)/admin/importMap.js\"",
    "migrate:create": "payload migrate:create",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/plugin-multi-tenant": "3.94.2",
    "@payloadcms/plugin-nested-docs": "3.94.2",
    "@payloadcms/plugin-seo": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "@thebensage-dev/ui": "^1.4.0",
    "graphql": "^16.15.0",
    "jose": "^6.2.18",
    "next": "16.4.6",
    "openid-client": "^6.9.1",
    "payload": "3.94.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.38.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild": false
  }
}
